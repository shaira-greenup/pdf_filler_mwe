{
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleDetection": "force",
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "types": ["vite/client"],

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },
  // Deliberately narrow, not "../scripts"/"../forms" wholesale: the UI only
  // ever imports these specific Bun-free modules (genericFields.ts,
  // gateGraph.ts, each form's schema.ts/mapping.ts). Everything else under
  // scripts/ and forms/ - the CLI entrypoint, the Bun-only lib/*.ts files,
  // every *.test.ts - uses Bun/Node APIs on purpose and must stay out of
  // this program's file set.
  "include": [
    "src",
    "../scripts/genericFields.ts",
    "../scripts/lib/gateGraph.ts",
    "../scripts/lib/hashParse.ts",
    "../forms/*/schema.ts",
    "../forms/*/mapping.ts"
  ]
}
